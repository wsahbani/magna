# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=magna
POSTGRES_PORT=5432

# API
NODE_ENV=production
API_PORT=3001
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1d

# Web
WEB_PORT=80

# Database URL (used by Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/magna
