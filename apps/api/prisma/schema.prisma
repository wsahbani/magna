// Node Templates for ReactFlow
model NodeTemplate {
  id          String  @id @default(cuid())
  name        String
  description String?
  category    String // "basic", "gateways", "events", "custom"
  nodeType    String

  // Default Styling
  defaultStyle Json // Default styles
  defaultSize  Json // Default width/height
  icon         String? // Icon for template
  thumbnail    String? // Template thumbnail

  // Configuration
  isCustom   Boolean @default(false)
  isPublic   Boolean @default(true)
  usageCount Int     @default(0)

  // Organization
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  creator   User?    @relation(fields: [createdBy], references: [id])

  @@unique([workspaceId, name])
  @@index([category])
  @@map("node_templates")
}

// ReactFlow Theme Configuration
model ProcessTheme {
  id          String  @id @default(cuid())
  name        String
  description String?

  // Node Styling
  nodeStyles Json // Default node styles by type

  // Edge Styling  
  edgeStyles Json // Default edge styles by type

  // Colors
  primaryColor   String @default("#1976d2")
  secondaryColor String @default("#dc004e")
  successColor   String @default("#388e3c")
  errorColor     String @default("#d32f2f")
  warningColor   String @default("#f57c00")

  // Typography
  fontFamily String @default("'Roboto', sans-serif")
  fontSize   Json // Font sizes for different elements

  // Layout
  spacing      Json // Spacing configuration
  borderRadius Json // Border radius configuration

  // Organization
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Metadata
  isDefault Boolean  @default(false)
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, name])
  @@map("process_themes")
}

