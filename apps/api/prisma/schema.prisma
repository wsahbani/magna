// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ====================================
// WORKSPACE & ORGANIZATION MANAGEMENT
// ====================================

// Workspace Management for Orange Group Multi-Department System
model Workspace {
  id          String        @id @default(cuid())
  name        String
  description String?
  code        String        @unique // e.g., "OTN", "OBS", "OFS"
  type        WorkspaceType
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Hierarchy - allows nested workspaces (Group > Entity > Direction > Department > Team)
  parentId String?
  parent   Workspace?  @relation("WorkspaceHierarchy", fields: [parentId], references: [id])
  children Workspace[] @relation("WorkspaceHierarchy")

  // Relations
  departments       Department[]
  processMaps       ProcessMap[]
  processes         Process[]
  procedures        Procedure[]
  workspaceMembers  WorkspaceMember[]
  workspaceSettings WorkspaceSettings?
  processTemplates  ProcessTemplate[]
  processTags       ProcessTag[]
  nodeTemplates     NodeTemplate[] // Workspace node templates
  processThemes     ProcessTheme[] // Workspace themes

  @@map("workspaces")
}

enum WorkspaceType {
  GROUPE // Orange Group level
  ENTITY // Orange Tunisie, Orange Business Services, etc.
  DIRECTION // Direction level
  DEPARTMENT // Department level
  TEAM // Team level

  @@map("workspace_types")
}

model Department {
  id          String   @id @default(cuid())
  name        String
  description String?
  code        String // e.g., "IT", "HR", "FIN", "OPS"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  users       User[]
  processMaps ProcessMap[]
  processes   Process[]
  procedures  Procedure[]

  @@unique([workspaceId, code])
  @@map("departments")
}

model WorkspaceMember {
  id       String        @id @default(cuid())
  role     WorkspaceRole
  joinedAt DateTime      @default(now())
  isActive Boolean       @default(true)

  // Relations
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@map("workspace_members")
}

enum WorkspaceRole {
  OWNER // Full control
  ADMIN // Manage processes and users
  EDITOR // Create and edit processes
  REVIEWER // Review and approve processes
  VIEWER // Read-only access

  @@map("workspace_roles")
}

model WorkspaceSettings {
  id                   String  @id @default(cuid())
  allowExternalUsers   Boolean @default(false)
  requireApproval      Boolean @default(true)
  maxProcessLevels     Int     @default(4)
  customFields         Json? // Custom metadata fields
  notificationSettings Json? // Email/notification preferences

  // Relations
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_settings")
}

// ====================================
// CORE MODELS
// ====================================

enum UserRole {
  ADMIN
  PROCESS_OWNER
  EDITOR
  VIEWER
  VALIDATOR

  @@map("user_roles")
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  firstName   String
  lastName    String
  displayName String? // Optional display name
  avatarUrl   String? // Profile picture URL
  phone       String?
  position    String? // Job title
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Authentication
  hashedPassword String?
  emailVerified  Boolean   @default(false)
  resetToken     String?
  resetTokenExp  DateTime?

  // OpenID Connect (Orange SSO)
  orangeId     String? @unique // Orange SSO unique identifier
  provider     String? @default("local") // local, orange-openid
  providerData Json? // Additional provider data

  // Admin flag - only admins can manage users and groups
  isAdmin Boolean @default(false)

  // User Role (Qualigram role)
  role UserRole @default(EDITOR)

  // Group Assignment (Un utilisateur appartient à un seul groupe)
  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id])

  // Relations
  departmentId                           String?
  department                             Department?                   @relation(fields: [departmentId], references: [id])
  workspaceMembers                       WorkspaceMember[]
  createdProcessMaps                     ProcessMap[]                  @relation("ProcessMapCreator")
  createdProcesses                       Process[]                     @relation("ProcessCreator")
  createdProcedures                      Procedure[]                   @relation("ProcedureCreator")
  ownedProcesses                         Process[]                     @relation("ProcessOwners")
  comments                               Comment[]
  commentResolutions                     Comment[]                     @relation("CommentResolver")
  approvals                              ApprovalRequest[]
  validationRequestsRequested            ProcessValidationRequest[]    @relation("ValidationRequestedBy")
  validationRequestsToValidate           ProcessValidationRequest[]    @relation("ValidationValidator")
  processMapValidationRequestsRequested  ProcessMapValidationRequest[] @relation("ProcessMapValidationRequestedBy")
  processMapValidationRequestsToValidate ProcessMapValidationRequest[] @relation("ProcessMapValidationValidator")
  procedureValidationRequestsRequested   ProcedureValidationRequest[]  @relation("ProcedureValidationRequestedBy")
  procedureValidationRequestsToValidate  ProcedureValidationRequest[]  @relation("ProcedureValidationValidator")
  readings                               ReadingConfirmation[]
  assignments                            ProcessAssignment[]
  auditLogs                              AuditLog[]
  notifications                          Notification[]
  createdTemplates                       ProcessTemplate[]
  nodeTemplates                          NodeTemplate[] // Created node templates
  sipocDiagrams                          SipocDiagram[]                @relation("UserSipoc")
  sipocHistory                           SipocHistory[]                @relation("SipocHistoryUser")
  sipocPermissions                       SipocPermission[]             @relation("SipocPermissionUser")
  sipocPermissionsGranted                SipocPermission[]             @relation("SipocPermissionGrantedBy")
  sipocComments                          SipocComment[]                @relation("SipocCommentUser")
  fipCards                               ProcessIdentityCard[]         @relation("UserFip")

  @@map("users")
}

// ====================================
// GROUP MANAGEMENT (Groupes métier)
// ====================================

model Group {
  id          String   @id @default(cuid())
  name        String   @unique // e.g., "Groupe RH", "Groupe Commercial", "Groupe Qualité"
  code        String   @unique // Short code: "RH", "COM", "QUAL"
  description String?
  color       String?  @default("#EA580C") // Orange by default
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  users       User[] // Users belonging to this group
  permissions GroupPermission[] // Group-level permissions

  @@map("groups")
}

// Group Permissions (optional: for fine-grained access control)
model GroupPermission {
  id         String   @id @default(cuid())
  groupId    String
  resource   String // e.g., "processes", "workspaces", "users"
  action     String // e.g., "create", "read", "update", "delete"
  conditions Json? // Optional conditions for permission
  createdAt  DateTime @default(now())

  // Relations
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, resource, action])
  @@map("group_permissions")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  type        RoleType // INTERNE / EXTERNE
  unitId      String?
  color       String?
  description String?

  unit        Unit?               @relation(fields: [unitId], references: [id])
  nodes       Node[]
  assignments ProcessAssignment[]

  @@map("roles")
}

model Unit {
  id    String @id @default(cuid())
  name  String @unique
  roles Role[]

  @@map("units")
}

enum RoleType {
  INTERNE
  EXTERNE
}

// ====================================
// PROCESS HIERARCHY & VERSIONING
// ====================================

// ProcessMap (Niveau 1) - Carte des processus
model ProcessMap {
  id          String        @id @default(cuid())
  title       String
  description String?
  code        String        @unique
  status      ProcessStatus @default(DRAFT)

  // Organisation
  workspaceId  String
  workspace    Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  // Métadonnées
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
  archivedAt  DateTime?

  // Relations
  createdById String
  createdBy   User   @relation("ProcessMapCreator", fields: [createdById], references: [id])

  // Relations hiérarchiques
  processes Process[] // Enfants (Process niveau 2)

  // Relations diagram
  flowDiagram FlowDiagram? // Diagram associé (level=1)

  // Relations collaboration
  comments           Comment[]
  documents          Document[]
  means              Mean[]
  tags               ProcessTag[]
  journalEntries     JournalEntry[]
  notifications      Notification[]
  validationRequests ProcessMapValidationRequest[]

  @@index([workspaceId])
  @@index([status])
  @@index([code])
  @@map("process_maps")
}

// Process (Niveau 2) - Processus métier
model Process {
  id          String        @id @default(cuid())
  title       String
  description String?
  code        String
  type        ProcessType   @default(FLOW) // FLOW ou SIPOC
  status      ProcessStatus @default(DRAFT)

  // Hiérarchie
  processMapId String?
  processMap   ProcessMap? @relation(fields: [processMapId], references: [id], onDelete: Cascade)

  // Organisation
  workspaceId  String
  workspace    Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  // Champs spécifiques Niveau 2
  objectif        String?
  perimetre       String?
  finalite        String?
  priority        ProcessPriority?      @default(MEDIUM)
  confidentiality ConfidentialityLevel? @default(INTERNAL)
  reviewFrequency Int?

  // Métadonnées
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  publishedAt    DateTime?
  archivedAt     DateTime?
  nextReviewDate DateTime?
  approvalDate   DateTime?

  // Relations
  createdById String
  createdBy   User   @relation("ProcessCreator", fields: [createdById], references: [id])
  owners      User[] @relation("ProcessOwners")

  // Relations hiérarchiques
  procedures Procedure[] // Enfants (Procedure niveau 3)

  // Relations spécifiques Niveau 2
  actors            ProcessActor[]
  processIOs        ProcessIO[]
  processIndicators Indicator[]
  processRisks      Risk[]
  linkedDocs        LinkedDocument[]
  qualigramTags     ProcessQualigramTag[]
  identityCard      ProcessIdentityCard?

  // Relations diagram
  flowDiagram FlowDiagram? // Diagram associé (level=2)

  // Relations spécifiques
  sipocDiagram SipocDiagram? // Si type=SIPOC

  // Relations collaboration
  comments           Comment[]
  approvalRequests   ApprovalRequest[]
  validationRequests ProcessValidationRequest[]
  readings           ReadingConfirmation[]
  documents          Document[]
  means              Mean[]
  tags               ProcessTag[]
  inputs             ProcessInput[]
  outputs            ProcessOutput[]
  journalEntries     JournalEntry[]
  notifications      Notification[]
  assignments        ProcessAssignment[]

  // Relations legacy Node (PYX4)
  subProcessNodes        Node[] @relation("NodeSubProcess")
  linkedInstructionNodes Node[] @relation("NodeInstruction")

  @@index([processMapId])
  @@index([workspaceId])
  @@index([status])
  @@index([type])
  @@map("processes")
}

// Procedure (Niveau 3) - Procédure opérationnelle
model Procedure {
  id          String          @id @default(cuid())
  title       String
  description String?
  code        String
  status      ProcedureStatus @default(DRAFT)

  // Hiérarchie
  processId String?
  process   Process? @relation(fields: [processId], references: [id], onDelete: Cascade)

  // Organisation
  workspaceId  String
  workspace    Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  // Champs spécifiques Niveau 3
  objective      String?
  scope          String?
  validatedBy    String?
  validatedAt    DateTime?
  effectiveDate  DateTime?
  expirationDate DateTime?

  // Métadonnées
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
  archivedAt  DateTime?

  // Relations
  createdById String
  createdBy   User   @relation("ProcedureCreator", fields: [createdById], references: [id])

  // Relations diagram
  flowDiagram FlowDiagram? // Diagram associé (level=3)

  // Relations collaboration
  comments           Comment[]
  documents          Document[]
  means              Mean[]
  tags               ProcessTag[]
  linkedDocs         LinkedDocument[]
  journalEntries     JournalEntry[]
  notifications      Notification[]
  validationRequests ProcedureValidationRequest[]

  @@index([processId])
  @@index([workspaceId])
  @@index([status])
  @@map("procedures")
}

enum ProcessPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("process_priorities")
}

enum ConfidentialityLevel {
  PUBLIC // Public processes
  INTERNAL // Internal to Orange Group
  RESTRICTED // Restricted to specific departments
  CONFIDENTIAL // Highly confidential

  @@map("confidentiality_levels")
}

enum ProcessType {
  FLOW
  SIPOC
}

enum ProcedureStatus {
  DRAFT
  IN_REVIEW
  VALIDATED
  ACTIVE
  RETIRED
}

enum ProcessStatus {
  DRAFT // En création
  IN_REVIEW
  VALIDATED
  PUBLISHED
  ARCHIVED
  OBSOLETE

  @@map("process_status")
}

// ====================================
// QUALIGRAM STRUCTURED MODELS
// ====================================

enum ActorType {
  ROLE
  DEPARTMENT
  EXTERNAL
  SYSTEM

  @@map("actor_types")
}

enum DocumentType {
  INPUT
  OUTPUT
  REFERENCE
  TEMPLATE
  RECORD

  @@map("document_types")
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("risk_levels")
}

enum QualigramNodeType {
  START
  END
  ACTIVITY
  DECISION
  SUBPROCESS
  DOCUMENT
  COMMENT
  CONNECTOR
  GATEWAY_AND
  GATEWAY_OR
  GATEWAY_XOR
  EVENT_TIMER
  EVENT_MESSAGE
  PROCESS_NODE // Représente un Process dans un MacroProcess
  PROCEDURE_NODE // Représente une Procedure dans un Process

  @@map("qualigram_node_types")
}

enum FlowNodeType {
  PROCESS // Dans ProcessMap (level=1)
  PROCEDURE // Dans Process (level=2)
  STEP // Dans Procedure (level=3)
  START
  END
  DECISION
  ACTION
  SUBFLOW

  @@map("flow_node_types")
}

enum QualigramEdgeType {
  SEQUENCE
  CONDITIONAL
  DEFAULT
  MESSAGE

  @@map("qualigram_edge_types")
}

// Acteurs structurés du processus
model ProcessActor {
  id               String    @id @default(uuid())
  processId        String
  name             String
  type             ActorType
  role             String? // Function/Position
  responsibilities String?
  order            Int       @default(0)

  process Process @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@index([processId])
  @@map("process_actors")
}

// Entrées/Sorties structurées
model ProcessIO {
  id          String  @id @default(uuid())
  processId   String
  name        String
  description String?
  type        String? // Document, Data, Material, etc.
  isInput     Boolean // true = input, false = output
  order       Int     @default(0)

  process Process @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@index([processId])
  @@index([isInput])
  @@map("process_ios")
}

// Indicateurs de performance
model Indicator {
  id          String  @id @default(uuid())
  processId   String
  name        String
  description String?
  formula     String?
  target      String? // Target value
  frequency   String? // Measurement frequency
  unit        String?
  order       Int     @default(0)

  process Process @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@index([processId])
  @@map("indicators")
}

// Risques structurés
model Risk {
  id          String    @id @default(uuid())
  processId   String
  description String
  level       RiskLevel
  probability Int? // 1-5 scale
  impact      Int? // 1-5 scale
  mitigation  String? // Mitigation actions
  owner       String? // Risk owner
  order       Int       @default(0)

  process Process @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@index([processId])
  @@index([level])
  @@map("risks")
}

// Documents liés structurés
model LinkedDocument {
  id          String       @id @default(uuid())
  processId   String?
  procedureId String?
  name        String
  reference   String? // Document reference code
  type        DocumentType
  url         String?
  filePath    String?
  version     String?
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  process   Process?   @relation(fields: [processId], references: [id], onDelete: Cascade)
  procedure Procedure? @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  @@index([processId])
  @@index([procedureId])
  @@index([type])
  @@map("linked_documents")
}

// Tags Qualigram (différent du Tag SIPOC)
model QualigramTag {
  id        String   @id @default(uuid())
  name      String   @unique
  color     String?
  createdAt DateTime @default(now())

  processes ProcessQualigramTag[]

  @@map("qualigram_tags")
}

// Relation Process-Tag Qualigram
model ProcessQualigramTag {
  processId String
  tagId     String

  process Process      @relation(fields: [processId], references: [id], onDelete: Cascade)
  tag     QualigramTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([processId, tagId])
  @@index([processId])
  @@index([tagId])
  @@map("process_qualigram_tags")
}

// ====================================
// FLOW DIAGRAM (ReactFlow)
// ====================================

model FlowDiagram {
  id        String @id @default(cuid())
  level     Int // 1=ProcessMap, 2=Process, 3=Procedure
  processId String // ID de ProcessMap, Process, ou Procedure selon level

  // Flow direction: horizontal (left-right) or vertical (top-bottom)
  flowDirection FlowDirection @default(HORIZONTAL)

  // Relations optionnelles selon level
  processMap   ProcessMap? @relation(fields: [processMapId], references: [id], onDelete: Cascade)
  processMapId String?     @unique

  process       Process? @relation(fields: [processId_ref], references: [id], onDelete: Cascade)
  processId_ref String?  @unique

  procedure   Procedure? @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  procedureId String?    @unique

  // ReactFlow data
  nodes    FlowNode[]
  edges    FlowEdge[]
  snapshot Json?      @db.Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([level, processId])
  @@index([level])
  @@index([processMapId])
  @@index([processId_ref])
  @@index([procedureId])
  @@map("flow_diagrams")
}

model FlowNode {
  id        String      @id @default(cuid())
  diagramId String
  diagram   FlowDiagram @relation(fields: [diagramId], references: [id], onDelete: Cascade)

  // ReactFlow properties
  rfId     String       @unique // ReactFlow ID (e.g., 'node-1')
  type     FlowNodeType
  label    String?
  data     Json?        @db.Json
  position Json         @db.Json // { x: number, y: number }

  // Entity linkage
  entityType         String? // PROCESS, PROCEDURE, STEP
  referencedEntityId String? // ID de Process/Procedure créé

  // Relations collaboration
  comments Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([diagramId])
  @@index([entityType])
  @@index([referencedEntityId])
  @@map("flow_nodes")
}

model FlowEdge {
  id        String      @id @default(cuid())
  diagramId String
  diagram   FlowDiagram @relation(fields: [diagramId], references: [id], onDelete: Cascade)

  rfId       String  @unique // ReactFlow ID (e.g., 'edge-1')
  sourceRfId String // rfId du FlowNode source
  targetRfId String // rfId du FlowNode target
  label      String?
  condition  String? // For conditional edges
  data       Json?   @db.Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([diagramId])
  @@index([sourceRfId])
  @@index([targetRfId])
  @@map("flow_edges")
}

// ====================================
// DIAGRAM NODES (PYX4 Lexique des formes)
// ====================================

model Node {
  id          String  @id @default(cuid())
  type        String
  label       String
  description String?

  // ReactFlow Positioning & Layout
  positionX Float  @default(0)
  positionY Float  @default(0)
  width     Float? @default(120)
  height    Float? @default(80)
  zIndex    Int?   @default(1)

  // ReactFlow Handle Configuration
  sourcePosition HandlePosition? @default(RIGHT)
  targetPosition HandlePosition? @default(LEFT)
  isConnectable  Boolean         @default(true)
  isDraggable    Boolean         @default(true)
  isSelectable   Boolean         @default(true)

  // Custom Styling
  style           Json? // Custom CSS styles
  className       String? // CSS class names
  backgroundColor String? // Background color
  borderColor     String? // Border color
  borderWidth     Int?    @default(1)
  borderRadius    Int?    @default(4)
  fontSize        Int?    @default(12)
  fontColor       String? @default("#000000")
  fontWeight      String? @default("normal")
  opacity         Float?  @default(1.0)

  // Icon & Visual Elements
  icon         String? // Icon name or URL
  iconPosition IconPosition? @default(LEFT)
  iconSize     Int?          @default(16)
  iconColor    String?

  // Conditional Styling
  hoverStyle    Json? // Styles when hovered
  selectedStyle Json? // Styles when selected
  errorStyle    Json? // Styles when in error state

  // Animation & Effects
  animation         String? // Animation type (pulse, shake, glow, etc.)
  animationDuration Int?    @default(1000)
  transition        String? // CSS transition properties

  // Process Logic
  roleId              String?
  subProcessId        String?
  isMacro             Boolean @default(false) // M. INSTRUCTION
  isCollaborative     Boolean @default(false) // INSTRUCTION CO.
  linkedDocumentId    String?
  linkedInstructionId String?

  // Business Rules & Validation
  isRequired      Boolean @default(false)
  validationRules Json? // Custom validation rules
  businessRules   Json? // Business logic rules

  // Timing & Performance
  estimatedDuration Int? // Duration in minutes
  actualDuration    Int? // Actual time taken
  slaTime           Int? // SLA time limit

  // Status & State
  status       NodeStatus @default(ACTIVE)
  isHidden     Boolean    @default(false)
  isLocked     Boolean    @default(false)
  lastModified DateTime   @default(now())

  // Data & Context
  data     Json? // Custom node data
  metadata Json? // Additional metadata
  tags     String[] // Node tags for filtering

  // ReactFlow Groups & Layers
  parentNodeId String? // For grouped nodes
  groupId      String? // Group identifier
  layerId      String? // Layer for z-ordering

  // Relations
  role              Role?     @relation(fields: [roleId], references: [id])
  subProcess        Process?  @relation("NodeSubProcess", fields: [subProcessId], references: [id])
  linkedDocument    Document? @relation("NodeDocument", fields: [linkedDocumentId], references: [id])
  linkedInstruction Process?  @relation("NodeInstruction", fields: [linkedInstructionId], references: [id])
  parentNode        Node?     @relation("NodeHierarchy", fields: [parentNodeId], references: [id])
  childNodes        Node[]    @relation("NodeHierarchy")

  outgoing Edge[] @relation("EdgeFrom")
  incoming Edge[] @relation("EdgeTo")

  constraints Constraint[]
  controls    ControlIndicator[]
  comments    Comment[] // Inline node comments

  @@index([type])
  @@index([status])
  @@index([groupId])
  @@map("nodes")
}

enum NodeType {
  // Start/End Events
  START_EVENT // Start Event (circle)
  END_EVENT // End Event (circle with thick border)
  INTERMEDIATE_EVENT // Intermediate Event

  // Activities
  TASK // Basic task (rectangle)
  USER_TASK // User task (person icon)
  SERVICE_TASK // Service task (gear icon)
  SCRIPT_TASK // Script task (script icon)
  SEND_TASK // Send task (envelope icon)
  RECEIVE_TASK // Receive task (envelope with arrow)
  MANUAL_TASK // Manual task (hand icon)
  BUSINESS_RULE_TASK // Business rule task (table icon)

  // Subprocess
  SUBPROCESS // Embedded subprocess
  CALL_ACTIVITY // Call activity (external process)

  // Gateways
  EXCLUSIVE_GATEWAY // XOR Gateway (diamond with X)
  INCLUSIVE_GATEWAY // OR Gateway (diamond with O)
  PARALLEL_GATEWAY // AND Gateway (diamond with +)
  EVENT_GATEWAY // Event-based gateway
  COMPLEX_GATEWAY // Complex gateway

  // Data Objects
  DATA_OBJECT // Data object
  DATA_STORE // Data store

  // Participants
  POOL // Pool (swimlane)
  LANE // Lane within pool

  // Artifacts
  TEXT_ANNOTATION // Text annotation
  GROUP // Group/frame

  // Custom Orange-specific (backwards compatibility)
  DEBUT // Start Event (legacy)
  FIN // End Event (legacy)
  INSTRUCTION // PYX4 Instruction
  SOUS_PROCEDURE // Sub-process (legacy)
  MACRO_INSTRUCTION // PYX4 Macro Instruction
  INSTRUCTION_COLLAB // PYX4 Collaborative task
  ACTION_AMONT // Upstream process
  ACTION_AVAL // Downstream process
  DOCUMENT_REF // Document reference
  MOYEN_REF // Means reference

  // ReactFlow Custom
  INPUT_NODE // Custom input node
  OUTPUT_NODE // Custom output node
  CUSTOM_NODE // Fully custom node

  @@map("node_types")
}

// ====================================
// EDGES & LOGIC
// ====================================

enum PathType {
  STRAIGHT // Straight line
  SMOOTHSTEP // Smooth step (default)
  STEP // Step
  BEZIER // Bezier curve
  SIMPLE_BEZIER // Simple bezier

  @@map("path_types")
}

model Edge {
  id     String  @id @default(cuid())
  fromId String
  toId   String
  type   String
  label  String?

  // ReactFlow Edge Configuration
  animated Boolean @default(false)
  hidden   Boolean @default(false)
  selected Boolean @default(false)

  // Styling
  style           Json? // Custom CSS styles
  className       String? // CSS class names
  strokeColor     String? @default("#b1b1b7")
  strokeWidth     Float?  @default(1.5)
  strokeDasharray String? // Dash pattern for dashed lines

  // Arrow/Marker Configuration
  markerStart String? // Start marker type
  markerEnd   String? @default("arrowclosed") // End marker type
  markerSize  Int?    @default(20)

  // Label Configuration
  labelStyle          Json? // Label styling
  labelShowBg         Boolean @default(true)
  labelBgStyle        Json? // Label background styling
  labelBgPadding      Json? // Label padding
  labelBgBorderRadius Int?    @default(2)

  // Path Configuration
  pathType     PathType @default(SMOOTHSTEP)
  sourceHandle String? // Source handle ID
  targetHandle String? // Target handle ID

  // Business Logic (backwards compatibility)
  condition   String? // For conditional flows
  isAnd       Boolean @default(true) // ET = true, OU = false
  priority    Int?    @default(0)
  probability Float? // Probability for stochastic flows
  isDefault   Boolean @default(false) // Default flow from gateway

  // Timing
  estimatedTime Int? // Estimated transition time
  actualTime    Int? // Actual transition time

  // Status & Metadata
  status   EdgeStatus @default(ACTIVE)
  metadata Json? // Additional metadata
  tags     String[] // Edge tags

  // Relations
  from Node @relation("EdgeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   Node @relation("EdgeTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
  @@index([type])
  @@index([status])
  @@map("edges")
}

enum EdgeType {
  // Basic Flow Types
  SEQUENCE_FLOW // Normal sequence flow
  CONDITIONAL_FLOW // Conditional sequence flow
  DEFAULT_FLOW // Default flow from gateway

  // Message Flows
  MESSAGE_FLOW // Message flow between pools

  // Association
  ASSOCIATION // Association (dotted line)
  DATA_ASSOCIATION // Data association

  // Custom Flow Types
  PARALLEL_FLOW // Parallel execution
  EXCLUSIVE_FLOW // Exclusive choice
  INCLUSIVE_FLOW // Inclusive choice

  // Legacy (backwards compatibility)
  SEQUENCE // Legacy sequence
  CONDITION // Legacy condition
  MESSAGE // Legacy message

  // Orange-specific
  CONTROL_FLOW // Control flow
  DATA_FLOW // Data flow
  RESOURCE_FLOW // Resource flow

  @@map("edge_types")
}

// ReactFlow specific enums
enum HandlePosition {
  TOP
  RIGHT
  BOTTOM
  LEFT

  @@map("handle_positions")
}

enum IconPosition {
  LEFT
  RIGHT
