model SipocDiagram {
  sipoc_id      String   @id @default(uuid())
  documentId    String   @unique @default(uuid()) @db.Uuid
  title         String
  description   String?
  process_owner String?
  department    String?
  status        String   @default("draft") // draft, published, archived
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  is_template   Boolean  @default(false)
  createdBy     String
  processId     String?  @unique // Relation 1-1 : optionnel mais unique (garantit 1-1)

  // Relations
  process             Process?          @relation(fields: [processId], references: [id], onDelete: Cascade)
  user                User              @relation("UserSipoc", fields: [createdBy], references: [id])
  elements            SipocElement[]
  connections         SipocConnection[]
  outgoingConnections SipocConnection[] @relation("FromSipoc")
  incomingConnections SipocConnection[] @relation("ToSipoc")
  history             SipocHistory[]
  permissions         SipocPermission[] @relation("PermissionSipoc")
  comments            SipocComment[]
  tags                SipocTag[]

  @@index([status])
  @@map("sipoc_diagrams")
}

model SipocElement {
  id          String      @id @default(uuid())
  documentId  String      @unique @default(uuid()) @db.Uuid
  type        ElementType
  title       String
  description String
  position    Int
  globalOrder Int? // For ordering suppliers
  flow_id     String? // Flow identifier for grouping elements
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Type-specific fields (optional)
  contactInfo     String? // For suppliers/customers
  qualityCriteria String? // For outputs
  responsibleRole String? // For process
  duration        String? // For process

  // Relations
  sipoc_id String
  sipoc    SipocDiagram      @relation(fields: [sipoc_id], references: [sipoc_id], onDelete: Cascade)
  outgoing SipocConnection[] @relation("FromElement")
  incoming SipocConnection[] @relation("ToElement")

  @@index([sipoc_id])
  @@index([type])
  @@map("sipoc_elements")
}

model SipocTag {
  sipoc_id   String
  tag_id     Int
  documentId String @unique @default(uuid()) @db.Uuid

  sipoc SipocDiagram @relation(fields: [sipoc_id], references: [sipoc_id])
  tag   Tag          @relation(fields: [tag_id], references: [tag_id])

  @@id([sipoc_id, tag_id])
}

model SipocConnection {
  connection_id     String   @id @default(uuid())
  documentId        String   @unique @default(uuid()) @db.Uuid
  source_element_id String
  target_element_id String
  description       String?
  status            String   @default("active")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  sipoc_id        String
  source_sipoc_id String
  target_sipoc_id String
  sipoc           SipocDiagram @relation(fields: [sipoc_id], references: [sipoc_id], onDelete: Cascade)
  sourceSipoc     SipocDiagram @relation("FromSipoc", fields: [source_sipoc_id], references: [sipoc_id], onDelete: Cascade)
  targetSipoc     SipocDiagram @relation("ToSipoc", fields: [target_sipoc_id], references: [sipoc_id], onDelete: Cascade)
  sourceElement   SipocElement @relation("FromElement", fields: [source_element_id], references: [id], onDelete: Cascade)
  targetElement   SipocElement @relation("ToElement", fields: [target_element_id], references: [id], onDelete: Cascade)

  @@index([sipoc_id])
  @@index([source_sipoc_id])
  @@index([target_sipoc_id])
  @@index([source_element_id])
  @@index([target_element_id])
  @@map("sipoc_connections")
}

model SipocHistory {
  history_id         Int      @id @default(autoincrement())
  documentId         String   @unique @default(uuid()) @db.Uuid
  sipoc_id           String
  changed_by         String
  changed_at         DateTime @default(now())
  change_description String?
  change_type        String?
