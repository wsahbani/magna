model SipocComment {
  comment_id        Int      @id @default(autoincrement())
  documentId        String   @unique @default(uuid()) @db.Uuid
  sipoc_id          String
  user_id           String
  comment_text      String
  created_at        DateTime @default(now())
  parent_comment_id Int?

  sipoc         SipocDiagram   @relation(fields: [sipoc_id], references: [sipoc_id])
  user          User           @relation("SipocCommentUser", fields: [user_id], references: [id])
  parentComment SipocComment?  @relation("ReplyTo", fields: [parent_comment_id], references: [comment_id])
  replies       SipocComment[] @relation("ReplyTo")
}

model Tag {
  tag_id     Int        @id @default(autoincrement())
  documentId String     @unique @default(uuid()) @db.Uuid
  name       String     @unique
  color      String?
  sipocs     SipocTag[]
}

