  APPROVED
  REJECTED
}

model ProcessValidationRequest {
  id            String           @id @default(cuid())
  processId     String
  requestedById String // Utilisateur qui demande la validation
  validatorId   String // Utilisateur qui doit valider
  status        ValidationStatus @default(PENDING)
  comment       String?
  validatedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  process     Process @relation(fields: [processId], references: [id], onDelete: Cascade)
  requestedBy User    @relation("ValidationRequestedBy", fields: [requestedById], references: [id])
  validator   User    @relation("ValidationValidator", fields: [validatorId], references: [id])

  @@unique([processId, validatorId])
  @@index([processId])
  @@index([validatorId])
  @@index([status])
  @@map("process_validation_requests")
}

enum ValidationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model ProcessMapValidationRequest {
  id            String           @id @default(cuid())
  processMapId  String
  requestedById String // Utilisateur qui demande la validation
  validatorId   String // Utilisateur qui doit valider
  status        ValidationStatus @default(PENDING)
  comment       String?
  validatedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  processMap  ProcessMap @relation(fields: [processMapId], references: [id], onDelete: Cascade)
  requestedBy User       @relation("ProcessMapValidationRequestedBy", fields: [requestedById], references: [id])
  validator   User       @relation("ProcessMapValidationValidator", fields: [validatorId], references: [id])

  @@unique([processMapId, validatorId])
  @@index([processMapId])
  @@index([validatorId])
  @@index([status])
  @@map("process_map_validation_requests")
}

model ProcedureValidationRequest {
  id            String           @id @default(cuid())
  procedureId   String
  requestedById String // Utilisateur qui demande la validation
  validatorId   String // Utilisateur qui doit valider
  status        ValidationStatus @default(PENDING)
  comment       String?
  validatedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  procedure   Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  requestedBy User      @relation("ProcedureValidationRequestedBy", fields: [requestedById], references: [id])
  validator   User      @relation("ProcedureValidationValidator", fields: [validatorId], references: [id])

  @@unique([procedureId, validatorId])
  @@index([procedureId])
  @@index([validatorId])
  @@index([status])
  @@map("procedure_validation_requests")
}

model ReadingConfirmation {
  id          String   @id @default(cuid())
  processId   String
  userId      String
  confirmedAt DateTime @default(now())

  process Process @relation(fields: [processId], references: [id], onDelete: Cascade)
