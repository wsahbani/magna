  procedureId  String?
  procedure    Procedure?  @relation(fields: [procedureId], references: [id], onDelete: SetNull)

  @@index([processMapId])
  @@index([processId])
  @@index([procedureId])
  @@map("means")
}

// ====================================
// COLLABORATION & DIFFUSION
// ====================================

model Comment {
  id         String    @id @default(cuid())
  content    String
  isResolved Boolean   @default(false)
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Relations
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  processMapId String?
  processMap   ProcessMap? @relation(fields: [processMapId], references: [id], onDelete: Cascade)
  processId    String?
  process      Process?    @relation(fields: [processId], references: [id], onDelete: Cascade)
  procedureId  String?
  procedure    Procedure?  @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  nodeId       String? // Conservé pour compatibilité avec Node existant
  node         Node?       @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  flowNodeId   String?
  flowNode     FlowNode?   @relation(fields: [flowNodeId], references: [id], onDelete: Cascade)

  // Optional parent for threaded comments
  parentId String?
  parent   Comment?  @relation("CommentThread", fields: [parentId], references: [id])
  replies  Comment[] @relation("CommentThread")

  // Optional resolved by user
  resolvedById String?
  resolvedBy   User?   @relation("CommentResolver", fields: [resolvedById], references: [id])

  @@index([processMapId])
  @@index([processId])
  @@index([procedureId])
  @@index([nodeId])
  @@index([flowNodeId])
  @@index([userId])
  @@map("comments")
}

model ApprovalRequest {
  id        String         @id @default(cuid())
  processId String
  userId    String
  status    ApprovalStatus @default(PENDING)
  comment   String?
  createdAt DateTime       @default(now())

  process Process @relation(fields: [processId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([processId, userId])
  @@map("approval_requests")
}

enum ApprovalStatus {
