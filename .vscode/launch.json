{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Turbo: Dev All",
            "type": "node-terminal",
            "request": "launch",
            "command": "pnpm dev",
            "cwd": "${workspaceFolder}",
            "env": {
                "NODE_ENV": "development",
                "OIDC_CLIENT_ID": "qualigram",
                "OIDC_CLIENT_SECRET": "qualigram",
                "OIDC_DISCOVERY_URI": "https://auth.qualigram.com/.well-known/openid-configuration",
                "OIDC_CALLBACK_URL": "http://localhost:3001/api/auth/oidc/callback",
                "DATABASE_URL": "postgresql://postgres:postgres@localhost:5432/magna_turbo"
            }
        },
        {
            "name": "Turbo: Dev Web",
            "type": "node-terminal",
            "request": "launch",
            "command": "pnpm --filter web dev",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Turbo: Dev API",
            "type": "node-terminal",
            "request": "launch",
            "command": "pnpm --filter api dev",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "NestJS: Debug API",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "pnpm",
            "runtimeArgs": [
                "--filter",
                "api",
                "start:debug"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "restart": true,
            "protocol": "inspector",
            "port": 9229,
            "skipFiles": ["<node_internals>/**"]
        },
        {
            "name": "Turbo: Build All",
            "type": "node-terminal",
            "request": "launch",
            "command": "pnpm build",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Turbo: Test All",
            "type": "node-terminal",
            "request": "launch",
            "command": "pnpm test",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Prisma: Studio",
            "type": "node-terminal",
            "request": "launch",
            "command": "pnpm --filter api prisma:studio",
            "cwd": "${workspaceFolder}"
        }
    ],
    "compounds": [
        {
            "name": "Full Stack: Dev",
            "configurations": ["Turbo: Dev Web", "Turbo: Dev API"],
            "stopAll": true,
            "presentation": {
                "hidden": false,
                "group": "fullstack",
                "order": 1
            }
        },
        {
            "name": "Full Stack: Debug API + Dev Web",
            "configurations": ["NestJS: Debug API", "Turbo: Dev Web"],
            "stopAll": true,
            "presentation": {
                "hidden": false,
                "group": "fullstack",
                "order": 2
            }
        }
    ]
}